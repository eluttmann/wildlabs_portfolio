# Copy to .env.local and fill in. Never commit .env.local.

# LLM director (chat + generative UI) through Vercel AI Gateway
AI_GATEWAY_API_KEY=

# World Labs (Marble worlds → Gaussian splats)
WORLD_LABS_API_KEY=

# Google: Nano Banana image generation via the Gemini API
GEMINI_API_KEY=

# Google Map Tiles API (Photorealistic 3D Tiles). Browser key: restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Odyssey live world-model sessions (server only, proxied)
ODYSSEY_API_KEY=

# NVIDIA Cosmos (build.nvidia.com), offline video generation
NVIDIA_API_KEY=

# Optional: Mapbox for the San Francisco outline
NEXT_PUBLIC_MAPBOX_TOKEN=
